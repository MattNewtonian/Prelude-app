# Anthropic API Key (required)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Server Port (optional, defaults to 3000)
PORT=3000

# Node Environment (optional)
NODE_ENV=development

# Steinway Soundfont Path (required for audio rendering)
# Download a high-quality Steinway soundfont and specify the path here
# Example: /usr/share/soundfonts/Steinway.sf2
# macOS default: /usr/local/share/soundfonts/default.sf2
SOUNDFONT_PATH=/usr/share/soundfonts/default.sf2

# Draft Mode (cost savings for development)
# When true: caps bars to 12, forces harmonyBudget=tight, reduces repair attempts to 2
PRELUDE_DRAFT_MODE=false
